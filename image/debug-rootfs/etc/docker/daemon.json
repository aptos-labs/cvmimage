{
    "data-root": "/mnt/ramdisk/private/docker",
    "experimental": true,
    "no-new-privileges": true,
    "icc": false,
    "userland-proxy": false,
    "firewall-backend": "nftables",
    "ipv6": false,
    "ip6tables": false,
    "features": {
        "containerd-snapshotter": true
    },
    "runtimes": {
        "nvidia": {
            "args": [],
            "path": "/usr/bin/nvidia-container-runtime"
        },
        "runsc": {
            "path": "/usr/bin/runsc",
            "runtimeArgs": [
                "--platform=systrap",
                "--overlay2=none"
            ]
        }
    }
}
